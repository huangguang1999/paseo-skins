{
  "name": "paseo-skin-loader",
  "version": "0.6.0",
  "private": true,
  "description": "Open-source Paseo themes, skins, Agent Skill, and safe macOS CDP theme loader",
  "keywords": [
    "paseo",
    "paseo-theme",
    "paseo-skins",
    "theme",
    "skin",
    "agent-skill",
    "ai-agent",
    "macos",
    "electron",
    "chrome-devtools-protocol",
    "desktop-customization"
  ],
  "author": "Huang Guang",
  "license": "MIT",
  "homepage": "https://huangguang1999.github.io/paseo-skins/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangguang1999/paseo-skins.git"
  },
  "bugs": {
    "url": "https://github.com/huangguang1999/paseo-skins/issues"
  },
  "bin": {
    "paseo-skin": "./src/cli.mjs"
  },
  "files": [
    "assets/",
    "src/",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md"
  ],
  "type": "module",
  "scripts": {
    "start": "node ./src/cli.mjs start",
    "inject": "node ./src/cli.mjs inject",
    "pause": "node ./src/cli.mjs pause",
    "reset": "node ./src/cli.mjs reset",
    "status": "node ./src/cli.mjs status",
    "doctor": "node ./src/cli.mjs doctor",
    "verify": "node ./src/cli.mjs verify",
    "test": "node --test",
    "build:site": "node ./scripts/build-site.mjs",
    "site": "npm run build:site && node ./scripts/serve-site.mjs",
    "check": "node --check ./src/cli.mjs && node --check ./src/cdp-client.mjs && node --check ./src/electron-launcher.mjs && node --check ./src/remote-theme.mjs && node --check ./src/stage-black-gold-skin.mjs && node --check ./src/theme-loader.mjs && node --check ./site/agent-integration.js && node --check ./site/app.js && node --check ./scripts/build-site.mjs && node --test"
  },
  "engines": {
    "node": ">=22"
  }
}
